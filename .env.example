# Copy to .env and fill in. Never commit the real .env.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/gramps-evidence-mcp`.
# Variables already set in the environment take precedence. A desktop client
# can set them in its own configuration instead; see the README.

# Base URL of the gramps-webapi (docker/docker-compose.yml serves it here):
GRAMPS_MCP_API_URL=http://localhost:5555

# A DEDICATED API user for the MCP (create it per the README; do not reuse your
# human web login). Credentials live only here, never in the TOML or in code.
GRAMPS_MCP_USERNAME=mcp
GRAMPS_MCP_PASSWORD=change-me

# Optional: path to the non-secret TOML config (default: ./gramps_mcp.toml)
# GRAMPS_MCP_CONFIG=/path/to/gramps_mcp.toml

# Optional: override the TOML expose_private flag (default false). True turns
# off the filtering of living and private people from bulk output.
# GRAMPS_MCP_EXPOSE_PRIVATE=false

# Optional: serve Streamable HTTP instead of stdio, for a remote client. It
# has no authentication of its own; read the README's Remote access section.
# GRAMPS_MCP_TRANSPORT=http
# GRAMPS_MCP_HOST=127.0.0.1
# GRAMPS_MCP_PORT=8090

# Optional: a Transkribus account (Scholar plan or above) for ocr_media's
# handwriting routes -- German Kurrent, Norwegian, a second witness on English.
# Every page costs credits (about 0.5, EUR 0.12), so a page is sent only when a
# call passes spend_credits=true, or within this many pages a calendar month.
# GRAMPS_MCP_TRANSKRIBUS_USERNAME=you@example.org
# GRAMPS_MCP_TRANSKRIBUS_PASSWORD=change-me
# GRAMPS_MCP_TRANSKRIBUS_PAGE_BUDGET=0
# GRAMPS_MCP_TRANSKRIBUS_API_URL=https://transkribus.eu/processing/v1
